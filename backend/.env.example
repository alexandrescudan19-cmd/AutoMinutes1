PORT=3500
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/autominutes
# For MongoDB Atlas, use your own user/password/db:
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority&appName=<app_name>
DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:5173
# Comma-separated list, or * only while testing public APIs.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_SECURE=false
MAIL_USER=mailtrap-user
MAIL_PASS=mailtrap-password
MAIL_FROM="AutoMinutes <no-reply@autominutes.local>"
GOOGLE_CLIENT_ID=google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3500/auth/google/callback
# GOOGLE_REFRESH_TOKEN=google-refresh-token
GOOGLE_CALENDAR_ID=primary
ENCRYPTION_KEY=64-char-hex-string-generate-with-crypto-randomBytes-32-toString-hex
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
# auto = use AI_API_KEY/OPENAI_API_KEY when present, otherwise Ollama, fallback when unavailable.
# ollama = fail if Ollama is unavailable.
# openai-compatible = use /v1/chat/completions providers (OpenAI, OpenRouter, Groq, Together, LM Studio, etc.).
# fallback = always use the built-in transcript processor.
AI_PROVIDER=auto
AI_FALLBACK_ON_ERROR=true
# Generic OpenAI-compatible AI provider config.
# For OpenAI:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=your-api-key
# For OpenRouter/Groq/Together/LM Studio, set their compatible base URL and model.
# AI_BASE_URL=
# AI_MODEL=
# AI_API_KEY=
# Optional headers for OpenRouter and similar gateways.
# AI_HTTP_REFERER=https://your-frontend-domain.example
# AI_APP_TITLE=AutoMinutes
AUTO_IMPORT_MEET_TRANSCRIPTS=true
AUTO_IMPORT_MEET_TRANSCRIPTS_INTERVAL_MS=300000
AUTO_IMPORT_MEET_TRANSCRIPTS_BATCH_SIZE=10
